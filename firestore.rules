rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSystemAdmin() {
      return isSignedIn() && request.auth.token.email == "system-scheduler@lifesync.ai";
    }

    function isBackend() {
      return (request.resource != null && request.resource.data.get('systemToken', '') == 'SysSchedulerPass123!') || 
             (resource != null && resource.data.get('systemToken', '') == 'SysSchedulerPass123!');
    }

    // --- Flat-Mapped Secure Collection Rules ---

    match /users/{userId} {
      allow get, write: if isOwner(userId) || isSystemAdmin();
      allow list: if isSystemAdmin();
    }

    match /users/{userId}/challenges/{challengeId} {
      allow read, write: if isOwner(userId) || isSystemAdmin();
    }

    match /users/{userId}/tasks/{logId} {
      allow read, write: if isOwner(userId) || isSystemAdmin();
    }

    match /users/{userId}/notes/{noteId} {
      allow read, write: if isOwner(userId) || isSystemAdmin();
    }

    match /users/{userId}/goals/{goalId} {
      allow read, write: if isOwner(userId) || isSystemAdmin();
    }

    match /users/{userId}/achievements/{achievementId} {
      allow read, write: if isOwner(userId) || isSystemAdmin();
    }

    match /users/{userId}/notification_preferences/{prefId} {
      allow read, write: if isOwner(userId) || isSystemAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isOwner(userId) || isSystemAdmin() || isBackend();
    }

    match /users/{userId}/analytics/{reportId} {
      allow read, write: if isOwner(userId) || isSystemAdmin();
    }

    match /users/{userId}/emailLogs/{emailLogId} {
      allow read, write: if isOwner(userId) || isSystemAdmin() || isBackend();
    }

    match /users/{userId}/email_logs/{emailLogId} {
      allow read, write: if isOwner(userId) || isSystemAdmin() || isBackend();
    }

    match /users/{userId}/affirmations/{affirmationId} {
      allow read: if isOwner(userId) || isSystemAdmin() || isBackend() || true;
      allow write: if isOwner(userId) || isSystemAdmin() || isBackend();
    }
  }
}
